# YOUR_USER と /home/YOUR_USER/s1lcd を自分の環境に合わせて書き換えてから
# /etc/systemd/system/ に置く
[Unit]
Description=ACEMAGIC S1 front LCD
After=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/s1lcd
ExecStart=/home/YOUR_USER/s1lcd/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
